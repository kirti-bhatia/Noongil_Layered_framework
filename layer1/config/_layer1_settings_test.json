{
    "runtime": {
        "execution_mode": "simulation",
        "default_acquisition_mode": "awareness",
        "continuous_operation": false,
        "cycle_interval_seconds": 1.0,
        "maximum_cycles": 1,
        "enable_validation": true,
        "fail_fast": false,
        "save_intermediate_outputs": true,
        "use_utc_timestamps": true,
        "schema_version": "1.0"
    },
    "network": {
        "enabled": false,
        "protocol": "websocket",
        "host": "0.0.0.0",
        "port": 8765,
        "endpoint": "/noongil/layer1",
        "connection_timeout_seconds": 10.0,
        "receive_timeout_seconds": 5.0,
        "heartbeat_interval_seconds": 10.0,
        "reconnect_enabled": true,
        "maximum_reconnect_attempts": 5,
        "reconnect_delay_seconds": 2.0,
        "maximum_packet_size_bytes": 10485760,
        "authentication_enabled": false,
        "authentication_token_env": "NOONGIL_PHONE_TOKEN",
        "compression_enabled": true,
        "verify_device_id": true
    },
    "vision": {
        "enabled": true,
        "target_width": 640,
        "target_height": 480,
        "target_channels": 3,
        "encoding": "jpeg",
        "jpeg_quality": 80,
        "minimum_fps": 2.0,
        "default_fps": 10.0,
        "maximum_fps": 30.0,
        "normalize_pixels": true,
        "resize_frames": true,
        "denoise_frames": false,
        "preserve_aspect_ratio": true,
        "calculate_brightness": true,
        "calculate_sharpness": true,
        "calculate_contrast": true,
        "calculate_frame_integrity": true,
        "low_brightness_threshold": 0.2,
        "minimum_sharpness_threshold": 0.25,
        "minimum_frame_integrity": 0.7,
        "maximum_frame_age_ms": 500.0,
        "frame_buffer_size": 30,
        "save_raw_frames": true,
        "save_preprocessed_frames": false
    },
    "audio": {
        "enabled": true,
        "sample_rate_hz": 16000,
        "channels": 1,
        "sample_width_bits": 16,
        "encoding": "pcm_s16le",
        "chunk_duration_ms": 1000.0,
        "overlap_duration_ms": 100.0,
        "convert_to_mono": true,
        "normalize_amplitude": true,
        "basic_noise_reduction": false,
        "calculate_amplitude": true,
        "calculate_signal_to_noise": true,
        "calculate_clipping_ratio": true,
        "calculate_silence_ratio": true,
        "calculate_packet_integrity": true,
        "generate_mel_spectrogram": false,
        "generate_mfcc": false,
        "number_of_mfcc_coefficients": 13,
        "silence_threshold": 0.02,
        "maximum_clipping_ratio": 0.1,
        "minimum_signal_to_noise_score": 0.3,
        "maximum_audio_age_ms": 1500.0,
        "audio_buffer_chunks": 10,
        "save_raw_audio": true,
        "save_preprocessed_audio": false
    },
    "spatial": {
        "enabled": true,
        "minimum_sampling_rate_hz": 0.2,
        "default_sampling_rate_hz": 1.0,
        "maximum_sampling_rate_hz": 5.0,
        "enable_gps": true,
        "enable_compass": true,
        "maximum_horizontal_accuracy_meters": 50.0,
        "preferred_horizontal_accuracy_meters": 10.0,
        "maximum_location_age_ms": 5000.0,
        "maximum_heading_age_ms": 2000.0,
        "minimum_speed_meters_per_second": 0.0,
        "maximum_reasonable_speed_meters_per_second": 60.0,
        "use_last_known_location": true,
        "maximum_last_known_location_age_seconds": 30.0
    },
    "motion": {
        "enabled": true,
        "enable_accelerometer": true,
        "enable_gyroscope": true,
        "enable_magnetometer": true,
        "minimum_sampling_rate_hz": 10.0,
        "default_sampling_rate_hz": 25.0,
        "maximum_sampling_rate_hz": 100.0,
        "motion_buffer_seconds": 3.0,
        "maximum_motion_age_ms": 250.0,
        "calculate_motion_intensity": true,
        "calculate_orientation_change": true,
        "calculate_sampling_continuity": true,
        "calculate_sensor_saturation": true,
        "low_motion_threshold": 0.15,
        "high_motion_threshold": 0.7,
        "accelerometer_maximum_absolute_value": 80.0,
        "gyroscope_maximum_absolute_value": 35.0,
        "magnetometer_maximum_absolute_value": 5000.0
    },
    "interaction": {
        "enabled": true,
        "enable_touch_input": true,
        "enable_button_input": true,
        "enable_voice_trigger": true,
        "enable_emergency_trigger": true,
        "emergency_button_press_count": 3,
        "emergency_press_window_seconds": 3.0,
        "allow_volume_button_shortcuts": true,
        "interaction_event_timeout_ms": 1000.0,
        "supported_actions": [
            "capture_request",
            "reading_mode_requested",
            "navigation_mode_requested",
            "awareness_mode_requested",
            "emergency_mode_requested",
            "pause_requested",
            "resume_requested",
            "stop_requested"
        ]
    },
    "device": {
        "expected_phone_device_type": "android_smartphone",
        "allow_unknown_phone": true,
        "enable_earphone_detection": true,
        "preferred_earphone_name": "realme Buds T200",
        "allow_phone_microphone_fallback": true,
        "allow_earphone_microphone": true,
        "record_battery_state": true,
        "record_network_state": true,
        "record_available_sensors": true,
        "minimum_supported_battery_level": 0.05
    },
    "environment": {
        "enabled": false,
        "enable_weather": false,
        "enable_map_context": false,
        "enable_traffic_context": false,
        "enable_transport_context": false,
        "request_timeout_seconds": 5.0,
        "cache_enabled": true,
        "maximum_cache_age_seconds": 300.0,
        "allow_network_failure": true,
        "weather_api_key_env": "NOONGIL_WEATHER_API_KEY",
        "maps_api_key_env": "NOONGIL_MAPS_API_KEY"
    },
    "namara": {
        "enabled": true,
        "activation_threshold": 0.45,
        "emergency_activation_threshold": 0.2,
        "weights": {
            "reliability_weight": 0.35,
            "context_weight": 0.35,
            "urgency_weight": 0.2,
            "energy_weight": 0.1
        },
        "enable_context_adaptive_activation": true,
        "enable_dynamic_sampling": true,
        "enable_energy_awareness": true,
        "enable_network_awareness": true,
        "battery_low_threshold": 0.2,
        "battery_critical_threshold": 0.1,
        "network_degraded_strength_threshold": 0.35,
        "network_high_latency_ms": 250.0,
        "motion_sampling_multiplier": 1.5,
        "emergency_sampling_multiplier": 2.0,
        "low_power_sampling_multiplier": 0.5,
        "degraded_network_sampling_multiplier": 0.7,
        "sampling_adjustment_interval_seconds": 2.0,
        "minimum_mode_duration_seconds": 2.0,
        "mode_sensor_priorities": {
            "idle": {
                "vision": 0.2,
                "audio": 0.3,
                "spatial": 0.1,
                "motion": 0.3,
                "interaction": 1.0,
                "wearable": 0.4,
                "environment": 0.0
            },
            "awareness": {
                "vision": 0.85,
                "audio": 0.75,
                "spatial": 0.5,
                "motion": 0.65,
                "interaction": 1.0,
                "wearable": 0.6,
                "environment": 0.2
            },
            "reading": {
                "vision": 1.0,
                "audio": 0.7,
                "spatial": 0.1,
                "motion": 0.3,
                "interaction": 1.0,
                "wearable": 0.6,
                "environment": 0.0
            },
            "navigation": {
                "vision": 1.0,
                "audio": 0.85,
                "spatial": 1.0,
                "motion": 1.0,
                "interaction": 1.0,
                "wearable": 0.8,
                "environment": 0.5
            },
            "emergency": {
                "vision": 1.0,
                "audio": 1.0,
                "spatial": 1.0,
                "motion": 1.0,
                "interaction": 1.0,
                "wearable": 1.0,
                "environment": 0.5
            },
            "low_power": {
                "vision": 0.35,
                "audio": 0.4,
                "spatial": 0.3,
                "motion": 0.4,
                "interaction": 1.0,
                "wearable": 0.5,
                "environment": 0.0
            },
            "degraded_network": {
                "vision": 0.5,
                "audio": 0.55,
                "spatial": 0.8,
                "motion": 0.85,
                "interaction": 1.0,
                "wearable": 0.6,
                "environment": 0.1
            }
        }
    },
    "synchronization": {
        "enabled": true,
        "default_window_ms": 250.0,
        "minimum_required_modalities": 1,
        "reference_modality_priority": [
            "interaction",
            "vision",
            "audio",
            "motion",
            "spatial",
            "wearable",
            "environment"
        ],
        "modality_tolerance_ms": {
            "vision": 100.0,
            "audio": 150.0,
            "spatial": 1000.0,
            "motion": 50.0,
            "interaction": 100.0,
            "wearable": 500.0,
            "environment": 300000.0
        },
        "allow_partial_synchronization": true,
        "minimum_alignment_score": 0.5,
        "drop_stale_data": true,
        "preserve_unaligned_data_in_metadata": true,
        "maximum_buffer_age_ms": 5000.0,
        "maximum_buffer_items_per_modality": 1000
    },
    "confidence": {
        "enabled": true,
        "weights": {
            "signal_quality": 0.3,
            "temporal_alignment": 0.2,
            "sensor_health": 0.2,
            "freshness": 0.15,
            "cross_modal_agreement": 0.15
        },
        "high_threshold": 0.8,
        "moderate_threshold": 0.55,
        "low_threshold": 0.3,
        "minimum_usable_confidence": 0.2,
        "conflict_penalty_strength": 1.0,
        "enable_cross_modal_conflict": true,
        "enable_confidence_normalization": true,
        "default_unknown_signal_quality": 0.5,
        "default_unknown_sensor_health": 0.75,
        "default_unknown_freshness": 0.5,
        "default_unknown_alignment": 0.5,
        "default_unknown_agreement": 0.5,
        "exclude_unavailable_modalities_from_weights": true
    },
    "recovery": {
        "enabled": true,
        "policy": "best_effort",
        "enable_short_gap_interpolation": true,
        "enable_cross_sensor_fallback": true,
        "allow_last_known_value": true,
        "maximum_interpolation_gap_ms": 500.0,
        "maximum_last_known_value_age_ms": 3000.0,
        "minimum_recovery_confidence": 0.3,
        "fallback_map": {
            "vision": [],
            "audio": [
                "wearable"
            ],
            "spatial": [
                "motion"
            ],
            "motion": [
                "spatial"
            ],
            "interaction": [],
            "wearable": [],
            "environment": []
        },
        "preserve_original_status": true,
        "mark_recovered_data_explicitly": true
    },
    "output": {
        "save_final_packet": true,
        "save_packet_history": false,
        "final_packet_filename": "multimodal_sensor_packet.json",
        "layer2_packet_filename": "layer1_sensor_packet.json",
        "pretty_print_json": true,
        "json_indent": 4,
        "atomic_file_write": true,
        "validate_before_save": true,
        "validate_before_dispatch": true,
        "dispatch_to_layer2": true,
        "overwrite_latest_packet": true,
        "packet_history_limit": 100
    },
    "logging": {
        "enabled": true,
        "level": "INFO",
        "log_to_console": true,
        "log_to_file": true,
        "log_filename": "layer1.log",
        "error_log_filename": "layer1_errors.log",
        "include_timestamp": true,
        "include_module_name": true,
        "maximum_log_size_bytes": 5242880,
        "backup_count": 3
    },
    "simulation": {
        "enabled": true,
        "scenario_name": "navigation_demo",
        "random_seed": 42,
        "simulate_vision": true,
        "simulate_audio": true,
        "simulate_spatial": true,
        "simulate_motion": true,
        "simulate_interaction": true,
        "simulate_wearable": true,
        "simulate_environment": false,
        "introduce_random_latency": true,
        "minimum_latency_ms": 5.0,
        "maximum_latency_ms": 80.0,
        "introduce_missing_modalities": false,
        "modality_missing_probability": 0.05,
        "introduce_degraded_quality": false,
        "degraded_quality_probability": 0.1
    }
}